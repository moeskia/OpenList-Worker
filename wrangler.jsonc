// =============================================================================
// OpenList-TSWorker · Cloudflare Workers 配置
// 文档：https://developers.cloudflare.com/workers/wrangler/configuration/
//
// 已启用 D1（关系表，binding=DB）+ KV（缓存/密钥/限流，binding=KV）。
//   D1 : openlist-tsworkers / 847712cd-89cd-4649-97dc-8ba7d6701c6e (APAC)
//   KV : openlist-tsworkers-kv / 8abc0a7e6de543258e5ed5ef4a26db98
//
// Secret（JWT_SECRET / ADMIN_PASS / ALLOW_URLS / MYSQL_URLS / EO_KV_URLS / CF_* 等）请在
// .dev.vars.example 或 .env.example 中声明 —— 部署按钮据此生成输入项，
// 用户填入的值会成为该 Worker 的 Secret，后续更新不会被覆盖。
// =============================================================================
{
  "name": "openlist-tsworkers",
  "main": "src/backend/worker.ts",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },

  // ===========================================================================
  // 普通环境变量（非敏感）
  // 注意：vars 会在每次 wrangler deploy 时被本文件覆盖（Secrets 不会）。
  // ===========================================================================
  "vars": {
    "ENVIRONMENT": "production",

    // 数据存储格式：
    //   map（默认）- 整对象序列化为单个 JSON 键值，适合 KV/Blob
    //   key        - 分 key 存储，每实体一条记录（如 users_1）
    //   sql        - 关系表格式，与 Go 后端一致（适用于 D1/MySQL）
    "DB_FORMAT": "sql",

    // 数据库驱动：
    //   auto（默认）- 自动检测，顺序 mysql → d1 → kv → cfkv → blob → do
    //   blob       - 腾讯云 EdgeOne Blob / 阿里云 ESA Blob
    //   cfkv       - Cloudflare KV REST API（需 CF_ACCOUNT / CF_KV_UUID / CF_API_KEY）
    //   kv         - Cloudflare KV binding（需下方 kv_namespaces）
    //   d1         - Cloudflare D1（需下方 d1_databases）
    //   do         - Cloudflare Durable Objects（需下方 durable_objects）
    //   mysql      - 外部 MySQL（需 MYSQL_URLS 或 MYSQL_HOST 等，仅 Node 运行时）
    // 说明：mysql 仅在配置了连接信息时才参与 auto 探测，避免无谓的 TCP 建连。
    "DB_DRIVER": "d1",

    // ── 安全鉴权（推荐以 Secret 类型配置，见 .dev.vars.example）──────────
    //
    // JWT 签名密钥（>=16 字符，兼作字段加密与定时任务鉴权）
    // "JWT_SECRET": "",
    //
    // 跳过安装向导，自动以该密码初始化 admin
    // "ADMIN_PASS": "",
    //
    // CORS 白名单（逗号分隔，不设则仅同源）
    // "ALLOW_URLS": "https://yourdomain.com",

    // ── 可选参数 ──────────────────────────────────────────────────────────
    //
    // 单次整体上传（/put、/form）大小上限，单位字节。默认 26214400（25MB）
    // "MAX_UPLOAD": "26214400",
    //
    // 分片上传单片大小上限，单位字节。默认 16777216（16MB）
    // "MAX_UPPART": "16777216",
    //
    // 前端静态资源 CDN 地址，支持 $version 占位符
    // "ASSET_URLS": "https://example.com/dist",
    //
    // 允许作为种子数据来源的主机白名单，逗号/空格分隔
    // "ALLOW_SEED": "",

    // ── Cloudflare KV REST API（DB_DRIVER=cfkv 时三项需全部填写）───────────
    //
    // KV namespace ID
    // "CF_KV_UUID": "",
    //
    // 账户 ID
    // "CF_ACCOUNT": "",
    //
    // 具有 KV 读写权限的 API Token
    // "CF_API_KEY": "",

    // ── EdgeOne Node 云函数 KV 代理（DB_DRIVER=kv 时可选）──────────────────
    //
    // EdgeOne 的 KV 绑定只注入 Edge Functions，不会注入 Node 云函数。
    // 运行在 EdgeOne Node 云函数时，必须经同部署的 Edge Functions 代理访问 KV。
    // 此处填部署 origin，如 https://your-project.edgeone.app
    // 留空则自动使用当前请求 origin（同一部署自调用）；跨域或本地调试才需显式设置。
    // "EO_KV_URLS": "",

    // ── MySQL（DB_DRIVER=mysql 时，方式一 / 方式二 二选一）─────────────────
    //
    // 方式一：连接串
    // "MYSQL_URLS": "mysql://user:pass@host:3306/db",
    //
    // 方式二：分项配置
    // "MYSQL_HOST": "127.0.0.1",
    // "MYSQL_PORT": "3306",
    // "MYSQL_USER": "root",
    // "MYSQL_PASS": "",
    // "MYSQL_NAME": "openlist",
  },

  "kv_namespaces": [
    { "binding": "KV", "id": "8abc0a7e6de543258e5ed5ef4a26db98" }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "openlist-tsworkers",
      "database_id": "847712cd-89cd-4649-97dc-8ba7d6701c6e"
    }
  ]
}
